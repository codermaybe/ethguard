        },
        {
          "items": {
            "additionalProperties": false,
            "properties": {
              "address": {
                "pattern": "^0x[0-9a-fA-F]{40}$",
                "title": "address",
                "type": "string"
              },
              "blockHash": {
                "pattern": "^0x[0-9a-f]{64}$",
                "title": "block hash",
                "type": "string"
              },
              "blockNumber": {
                "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
                "title": "block number",
