{
  "id": "getlogs-empty-array-overlap",
  "target": {
    "method": "eth_getLogs",
    "part": "result"
  },
  "reason": "The shared FilterResults schema uses oneOf for arrays of hashes and arrays of logs. Both branches match an empty array, rejecting a valid empty eth_getLogs result. Use anyOf for this method only to admit their overlap while preserving the existing public two-branch generated model and all non-empty branch constraints. This does not extend the method admission/protected logs contract to hash results.",
  "references": [
    "https://github.com/ethereum/execution-apis/blob/981aa66d79364be8322a9c358aaf0a571cca0873/src/schemas/filter.yaml",
    "https://github.com/ethereum/execution-apis/blob/981aa66d79364be8322a9c358aaf0a571cca0873/src/eth/filter.yaml",
    "https://eips.ethereum.org/EIPS/eip-1474#eth_getlogs"
  ],
  "retireWhen": "Review on every pin change. Remove when the upstream eth_getLogs result admits an empty log array without ambiguous oneOf validation. A future method-specific logs-only model requires a separate public type and method-semantics migration.",
  "patch": [
    {
      "op": "move",
      "from": "/oneOf",
      "path": "/anyOf"
    }
  ],
  "kind": "patch",
  "before": [
    {
      "pointer": "/anyOf",
      "absent": true
    },
    {
      "pointer": "/oneOf",
      "value": [
        {
          "items": {
            "pattern": "^0x[0-9a-f]{64}$",
            "title": "32 byte hex value",
            "type": "string"
          },
          "title": "new block or transaction hashes",
          "type": "array"
        },
        {
          "items": {
            "additionalProperties": false,
            "properties": {
              "address": {
                "pattern": "^0x[0-9a-fA-F]{40}$",
                "title": "address",
                "type": "string"
              },
              "blockHash": {
                "pattern": "^0x[0-9a-f]{64}$",
                "title": "block hash",
                "type": "string"
              },
              "blockNumber": {
                "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
                "title": "block number",
                "type": "string"
              },
              "blockTimestamp": {
                "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
                "title": "block timestamp",
                "type": "string"
              },
              "data": {
                "pattern": "^0x[0-9a-f]*$",
                "title": "data",
                "type": "string"
              },
              "logIndex": {
                "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
                "title": "log index",
                "type": "string"
              },
              "removed": {
                "title": "removed",
                "type": "boolean"
              },
              "topics": {
                "items": {
                  "pattern": "^0x[0-9a-f]{64}$",
                  "title": "32 hex encoded bytes",
                  "type": "string"
                },
                "title": "topics",
                "type": "array"
              },
              "transactionHash": {
                "pattern": "^0x[0-9a-f]{64}$",
                "title": "transaction hash",
                "type": "string"
              },
              "transactionIndex": {
                "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
                "title": "transaction index",
                "type": "string"
              }
            },
            "required": [
              "transactionHash"
            ],
            "title": "log",
            "type": "object"
          },
          "title": "new logs",
          "type": "array"
        }
      ]
    }
  ],
  "after": [
