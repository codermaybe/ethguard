{
  "id": "transaction-query-pending-context",
  "sourceVersion": "981aa66d79364be8322a9c358aaf0a571cca0873",
  "sourceCommit": "981aa66d79364be8322a9c358aaf0a571cca0873",
  "target": {
    "method": "eth_getTransactionByHash",
    "part": "result"
  },
  "reason": "An independent transaction query must preserve required but nullable pending inclusion context. EIP-1474 specifies null blockHash, blockNumber and transactionIndex. The locked geth implementation additionally emits blockTimestamp:null. Embedded block transactions keep the original non-nullable schema. Whole-context pending/mined consistency remains method admission responsibility.",
  "references": [
    "https://eips.ethereum.org/EIPS/eip-1474#eth_gettransactionbyhash",
    "https://github.com/ethereum/go-ethereum/blob/v1.17.10/internal/ethapi/api.go",
    "https://github.com/ethereum/execution-apis/blob/981aa66d79364be8322a9c358aaf0a571cca0873/src/schemas/transaction.yaml"
  ],
  "retireWhen": "On every upstream pin change, review the independent query schema. Remove this correction when upstream admits the supported pending inclusion context; narrow or revise the timestamp part if its source contract changes. Never apply it to embedded block transactions.",
  "inputSchemaSHA256": "b3664c7762184533823ea8c8ea073da01c7f83a30b7a99225578af98b36e2f5e",
  "outputSchemaSHA256": "cb10ef89a4da14f2bbf4403026ac535d6b4ce35a6fcca68d26b8b758b0841fa9",
