          "title": "Return logs",
          "type": "array"
         },
         "maxUsedGas": {
          "pattern": "^0x(0|[1-9a-f][0-9a-f]{0,15})$",
          "title": "Maximum gas used during execution before refunds",
          "type": "string"
         },
         "returnData": {
          "pattern": "^0x[0-9a-f]*$",
          "title": "Return data",
          "type": "string"
         },
         "status": {
          "pattern": "^0x1$",
          "title": "Call Status Success",
          "type": "string"
         }
        },
        "required": [
