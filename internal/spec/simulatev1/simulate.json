{
 "version": "981aa66d79364be8322a9c358aaf0a571cca0873",
 "method": "eth_simulateV1",
 "params": [
  {
   "name": "Payload",
   "required": true,
   "schema": {
    "properties": {
     "blockStateCalls": {
      "description": "Definition of blocks that can contain calls and overrides",
      "properties": {
       "blockOverrides": {
        "description": "Block overrides can be used to replace fields in a block.\ndefault: no block override.",
        "properties": {
         "baseFeePerGas": {
          "pattern": "^0x(0|[1-9a-f][0-9a-f]{0,63})$",
          "title": "Base fee per unit of gas",
          "type": "string"
         },
         "blobBaseFee": {
          "pattern": "^0x(0|[1-9a-f][0-9a-f]{0,15})$",
          "title": "Base fee per unit of blob gas",
          "type": "string"
         },
         "feeRecipient": {
          "description": "Address set by the proposer/builder to receive priority fees. Often matches the block header `feeRecipient` field but is not the COINBASE EVM opcode.",
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Fee recipient",
          "type": "string"
         },
         "gasLimit": {
          "pattern": "^0x(0|[1-9a-f][0-9a-f]{0,15})$",
          "title": "Gas limit",
          "type": "string"
         },
         "number": {
          "description": "When overriding block numbers across multiple blocks, block number need to be increasing. Skipping over blocks numbers is possible. If block number is not specified, it's incremented by one for each block.",
          "pattern": "^0x(0|[1-9a-f][0-9a-f]{0,15})$",
          "title": "Number",
          "type": "string"
         },
         "prevRandao": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "The Previous value of randomness beacon",
          "type": "string"
         },
         "time": {
          "description": "Time must either increase or remain constant relative to the previous block. If time is not specified, it's incremented by one for each block.",
          "pattern": "^0x(0|[1-9a-f][0-9a-f]{0,15})$",
          "title": "Time",
          "type": "string"
         },
         "withdrawals": {
          "description": "This array can have a maximum length of 16.",
          "items": {
           "additionalProperties": false,
           "properties": {
            "address": {
             "pattern": "^0x[0-9a-fA-F]{40}$",
             "title": "recipient address for withdrawal value",
             "type": "string"
            },
            "amount": {
             "pattern": "^0x(0|[1-9a-f][0-9a-f]{0,63})$",
             "title": "value contained in withdrawal",
             "type": "string"
            },
            "index": {
             "pattern": "^0x(0|[1-9a-f][0-9a-f]{0,15})$",
             "title": "index of withdrawal",
             "type": "string"
            },
            "validatorIndex": {
             "pattern": "^0x(0|[1-9a-f][0-9a-f]{0,15})$",
             "title": "index of validator that generated withdrawal",
             "type": "string"
            }
           },
           "required": [
            "index",
            "validatorIndex",
            "address",
            "amount"
           ],
           "title": "Validator withdrawal",
           "type": "object"
          },
          "title": "Withdrawals made by validators",
          "type": "array"
         }
        },
        "title": "Block overrides",
        "type": "object"
       },
       "calls": {
        "description": "List of transactions to execute at this block/state.\nDefault: []",
        "items": {
         "properties": {
          "accessList": {
           "description": "EIP-2930 access list\nDefault: []",
           "items": {
            "additionalProperties": false,
            "properties": {
             "address": {
              "pattern": "^0x[0-9a-fA-F]{40}$",
              "title": "hex encoded address",
              "type": "string"
             },
             "storageKeys": {
              "items": {
               "pattern": "^0x[0-9a-f]{64}$",
               "title": "32 byte hex value",
               "type": "string"
              },
              "type": "array"
             }
            },
            "required": [
             "address",
             "storageKeys"
            ],
            "title": "Access list entry",
            "type": "object"
           },
           "title": "accessList",
           "type": "array"
          },
          "blobVersionedHashes": {
           "description": "EIP-4844 versioned hashes\nDefault: []",
           "items": {
            "pattern": "^0x[0-9a-f]{64}$",
            "title": "32 byte hex value",
            "type": "string"
           },
           "title": "Blob versioned hashes",
           "type": "array"
          },
          "from": {
           "description": "Default: null",
           "pattern": "^0x[0-9a-fA-F]{40}$",
           "title": "from address",
           "type": "string"
          },
          "gas": {
           "description": "Default: Remaining gas in the current block",
           "pattern": "^0x(0|[1-9a-f][0-9a-f]{0,15})$",
           "title": "gas limit",
           "type": "string"
          },
          "gasPrice": {
           "description": "The gas price willing to be paid by the sender in wei\nDefault: 0",
           "pattern": "^0x(0|[1-9a-f][0-9a-f]{0,63})$",
           "title": "gas price",
           "type": "string"
          },
          "input": {
           "description": "Default: no data",
           "pattern": "^0x[0-9a-f]*$",
           "title": "input data",
           "type": "string"
          },
          "maxFeePerBlobGas": {
           "description": "The maximum total fee per blob gas the sender is willing to pay in wei\nDefault: 0",
           "pattern": "^0x(0|[1-9a-f][0-9a-f]{0,63})$",
           "title": "max fee per blob gas",
           "type": "string"
          },
          "maxFeePerGas": {
           "description": "The maximum total fee per gas the sender is willing to pay (includes the network / base fee and miner / priority fee) in wei\nDefault: 0",
           "pattern": "^0x(0|[1-9a-f][0-9a-f]{0,63})$",
           "title": "max fee per gas",
           "type": "string"
          },
          "maxPriorityFeePerGas": {
           "description": "Maximum fee per gas the sender is willing to pay to miners in wei\nDefault: 0",
           "pattern": "^0x(0|[1-9a-f][0-9a-f]{0,63})$",
           "title": "max priority fee per gas",
           "type": "string"
          },
          "nonce": {
           "description": "Default: Defaults to correct nonce",
           "pattern": "^0x(0|[1-9a-f][0-9a-f]{0,15})$",
           "title": "nonce",
           "type": "string"
          },
          "to": {
           "description": "Default: 0x0",
           "pattern": "^0x[0-9a-fA-F]{40}$",
           "title": "to address",
           "type": "string"
          },
          "type": {
           "description": "Default: 0x2",
           "pattern": "^0x[0-9a-f]{1,2}$",
           "title": "type",
           "type": "string"
          },
          "value": {
           "description": "Default: 0",
           "pattern": "^0x(0|[1-9a-f][0-9a-f]{0,63})$",
           "title": "value",
           "type": "string"
          }
         },
         "title": "Transaction object type for call",
         "type": "object"
        },
        "title": "calls",
        "type": "array"
       },
       "stateOverrides": {
        "additionalProperties": false,
        "description": "State overrides can be used to replace existing blockchain state with new state.\nDefault: no state overrides",
        "patternProperties": {
         "^0x[a-fA-F0-9]{40}$": {
          "description": "It is possible to override any kind of address (EOA's, contracts and precompiles).\nA client MUST reject a key that it does not support with error code -32602. A client MAY treat a key that differs from a key defined in this schema only in case as that defined key. It MUST then apply the key, and MUST reject two keys that differ only in case and name the same defined key with error code -32602. A client MAY support other keys that this schema does not define.",
          "not": {
           "required": [
            "state",
            "stateDiff"
           ]
          },
          "properties": {
           "balance": {
            "pattern": "^0x(0|[1-9a-f][0-9a-f]{0,63})$",
            "title": "Balance",
            "type": "string"
           },
           "code": {
            "pattern": "^0x[0-9a-f]*$",
            "title": "Code",
            "type": "string"
           },
           "movePrecompileToAddress": {
            "description": "Moves addresses precompile into the specified address. This move is done before the 'code' override is set. Can only move precompiles. The move does not change the EIP-2929 set of addresses that are warm at the start of each call. That set keeps the precompile addresses of the active fork, and the destination address is not warm because of the move.",
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "title": "MovePrecompileToAddress",
            "type": "string"
           },
           "nonce": {
            "pattern": "^0x(0|[1-9a-f][0-9a-f]{0,15})$",
            "title": "Nonce",
            "type": "string"
           },
           "state": {
            "additionalProperties": false,
            "description": "Key-value mapping to override all slots in the account storage before executing the call. This functions similar to eth_call's state parameter.",
            "patternProperties": {
             "^0x[a-fA-F0-9]{64}$": {
              "pattern": "^0x[0-9a-f]{64}$",
              "title": "32 byte hex value",
              "type": "string"
             }
            },
            "title": "Storage",
            "type": "object"
           },
           "stateDiff": {
            "additionalProperties": false,
            "description": "Key-value mapping to override individual slots in the account storage before executing the call. This functions similar to eth_call's state parameter.",
            "patternProperties": {
             "^0x[a-fA-F0-9]{64}$": {
              "pattern": "^0x[0-9a-f]{64}$",
              "title": "32 byte hex value",
              "type": "string"
             }
            },
            "title": "Storage difference",
            "type": "object"
           }
          },
          "title": "Details of an account to be overridden",
          "type": "object"
         }
        },
        "title": "State overrides",
        "type": "object"
       }
      },
      "title": "Block State Calls",
      "type": "array"
     },
     "returnFullTransactions": {
      "description": "When true, the method returns full transaction objects, otherwise, just hashes are returned.",
      "title": "Return Full Transactions",
      "type": "boolean"
     },
     "traceTransfers": {
      "description": "Adds ETH transfers as ERC20 transfer events to the logs. These transfers have emitter contract parameter set as address(0xeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee).\nIn blocks where EIP-7708 is active, no synthetic transfer events are added. The protocol transfer logs emitted from address(0xfffffffffffffffffffffffffffffffffffffffe) cover the same transfers with the same topics and data, and the flag has no effect. The flag is deprecated for these blocks.\nDefault: false.",
      "title": "Trace ETH Transfers",
      "type": "boolean"
     },
     "validation": {
      "description": "When true, the eth_simulateV1 does all validations that a normal EVM would do, except contract sender and signature checks. When false, eth_simulateV1 behaves like eth_call.\nDefault: false.",
      "title": "Validation",
      "type": "boolean"
     }
    },
    "required": [
     "blockStateCalls"
    ],
    "title": "Arguments for eth_simulate",
    "type": "object"
   }
  },
  {
   "name": "Block tag",
   "schema": {
    "anyOf": [
     {
      "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
      "title": "Block number",
      "type": "string"
     },
     {
      "description": "`earliest`: The lowest numbered block the client has available; `finalized`: The most recent crypto-economically secure block, cannot be re-orged outside of manual intervention driven by community coordination; `safe`: The most recent block that is safe from re-orgs under honest majority and certain synchronicity assumptions; `latest`: The most recent block in the canonical chain observed by the client, this block may be re-orged out of the canonical chain even under healthy/normal conditions; `pending`: A sample next block built by the client on top of `latest` and containing the set of transactions usually taken from local mempool. If the `safe` or `finalized` tag cannot be resolved to a block, the method responds as it does for an unknown block.",
      "enum": [
       "earliest",
       "finalized",
       "safe",
       "latest",
       "pending"
      ],
      "title": "Block tag",
      "type": "string"
     },
     {
      "pattern": "^0x[0-9a-f]{64}$",
      "title": "Block hash",
      "type": "string"
     },
     {
      "additionalProperties": false,
      "properties": {
       "blockNumber": {
        "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
        "title": "Block number",
        "type": "string"
       }
      },
      "required": [
       "blockNumber"
      ],
      "title": "EIP-1898 block number object",
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "blockHash": {
        "pattern": "^0x[0-9a-f]{64}$",
        "title": "Block hash",
        "type": "string"
       },
       "requireCanonical": {
        "description": "Whether the block hash must belong to a canonical block, defaulting to `false`. When `true` and the referenced block is not canonical, EIP-1898 recommends `-32000: Invalid input`. A block that cannot be found takes precedence and is reported as `-32001: Resource not found`.",
        "title": "Require canonical",
        "type": "boolean"
       }
      },
      "required": [
       "blockHash"
      ],
      "title": "EIP-1898 block hash object",
      "type": "object"
     }
    ],
    "title": "Block number, tag, or block hash"
   }
  }
 ],
 "result": {
  "items": {
   "description": "A simulated block carries every header field that a real block carries at the fork active for that block, including blockAccessListHash and slotNumber after Amsterdam. The only exception is slotNumber, which is omitted when the parent block has none. Header fields that the simulation cannot derive take the default values documented in the eth_simulateV1 notes.",
   "properties": {
    "baseFeePerGas": {
     "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
     "title": "Base fee per gas",
     "type": "string"
    },
    "blobGasUsed": {
     "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
     "title": "Blob gas used",
     "type": "string"
    },
    "blockAccessListHash": {
     "pattern": "^0x[0-9a-f]{64}$",
     "title": "EIP-7928 block access list hash",
     "type": "string"
    },
    "calls": {
     "items": {
      "oneOf": [
       {
        "description": "The error codes are enforced by the spec. A revert message starts with \"execution reverted\". Other error messages are client-specific text.",
        "properties": {
         "error": {
          "oneOf": [
           {
            "properties": {
             "code": {
              "const": 3
             },
             "message": {
              "pattern": "^execution reverted.*",
              "type": "string"
             }
            },
            "required": [
             "code",
             "message"
            ],
            "type": "object"
           },
           {
            "properties": {
             "code": {
              "const": -32015
             },
             "message": {
              "type": "string"
             }
            },
            "required": [
             "code",
             "message"
            ],
            "type": "object"
           }
          ]
         },
         "gasUsed": {
          "pattern": "^0x(0|[1-9a-f][0-9a-f]{0,15})$",
          "title": "Return gasUsed",
          "type": "string"
         },
         "maxUsedGas": {
          "pattern": "^0x(0|[1-9a-f][0-9a-f]{0,15})$",
          "title": "Maximum gas used during execution before refunds",
          "type": "string"
         },
         "returnData": {
          "pattern": "^0x[0-9a-f]*$",
          "title": "Return data",
          "type": "string"
         },
         "status": {
          "pattern": "^0x0$",
          "title": "Call Status Failure",
          "type": "string"
         }
        },
        "required": [
         "status",
         "returnData",
         "gasUsed",
         "error"
        ],
        "title": "Result of call failure",
        "type": "object"
       },
       {
        "properties": {
         "gasUsed": {
          "pattern": "^0x(0|[1-9a-f][0-9a-f]{0,15})$",
          "title": "Return gasUsed",
          "type": "string"
         },
         "logs": {
          "items": {
           "additionalProperties": false,
           "properties": {
            "address": {
             "pattern": "^0x[0-9a-fA-F]{40}$",
             "title": "address",
             "type": "string"
            },
            "blockHash": {
             "pattern": "^0x[0-9a-f]{64}$",
             "title": "block hash",
             "type": "string"
            },
            "blockNumber": {
             "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
             "title": "block number",
