            "logIndex": {
             "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
             "title": "log index",
             "type": "string"
            },
            "removed": {
             "title": "removed",
             "type": "boolean"
            },
            "topics": {
             "items": {
              "pattern": "^0x[0-9a-f]{64}$",
              "title": "32 hex encoded bytes",
              "type": "string"
             },
             "title": "topics",
             "type": "array"
            },
            "transactionHash": {
             "pattern": "^0x[0-9a-f]{64}$",
             "title": "transaction hash",
             "type": "string"
            },
            "transactionIndex": {
             "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
