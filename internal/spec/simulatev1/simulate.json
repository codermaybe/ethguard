        "type": "string"
       },
       "title": "Transaction hashes",
       "type": "array"
      },
      {
       "items": {
        "oneOf": [
         {
          "properties": {
           "accessList": {
            "description": "EIP-2930 access lists",
            "items": {
             "additionalProperties": false,
             "properties": {
              "address": {
               "pattern": "^0x[0-9a-fA-F]{40}$",
               "title": "hex encoded address",
               "type": "string"
              },
              "storageKeys": {
               "items": {
                "pattern": "^0x[0-9a-f]{64}$",
                "title": "32 byte hex value",
                "type": "string"
               },
               "type": "array"
              }
             },
             "required": [
