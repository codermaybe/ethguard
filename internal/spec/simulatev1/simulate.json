               "pattern": "^0x[0-9a-fA-F]{40}$",
               "title": "hex encoded address",
               "type": "string"
              },
              "chainId": {
               "description": "Chain ID on which this transaction is valid",
               "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
               "title": "chainId",
               "type": "string"
              },
              "nonce": {
               "pattern": "^0x(0|[1-9a-f][0-9a-f]*)$",
               "title": "nonce",
               "type": "string"
              },
              "r": {
               "pattern": "^0x(0|[1-9a-f][0-9a-f]{0,63})$",
